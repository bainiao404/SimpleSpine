{
  "name": "simple-pixi-spine",
  "version": "0.1.0-pixi7",
  "description": "Unified spine-pixi runtime with SimplePixiSpine wrapper built using Esbuild",
  "main": "./dist/simple-pixi-spine.js",
  "module": "./dist/simple-pixi-spine.mjs",
  "types": "./dist/types/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/src/index.d.ts",
      "import": "./dist/simple-pixi-spine.mjs",
      "require": "./dist/simple-pixi-spine.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node build.mjs && tsc"
  },
  "peerDependencies": {
    "@pixi/core": "^7.0.0",
    "@pixi/display": "^7.0.0",
    "@pixi/graphics": "^7.0.0",
    "@pixi/mesh": "^7.0.0",
    "@pixi/mesh-extras": "^7.0.0",
    "@pixi/sprite": "^7.0.0",
    "@pixi/assets": "^7.0.0"
  },
  "devDependencies": {
    "@esotericsoftware/spine-pixi-v7": "^4.2.83",
    "@pixi/core": "^7.4.2",
    "@pixi/display": "^7.4.2",
    "@pixi/graphics": "^7.4.2",
    "@pixi/mesh": "^7.4.2",
    "@pixi/mesh-extras": "^7.4.2",
    "@pixi/sprite": "^7.4.2",
    "@pixi/assets": "^7.4.2",
    "esbuild": "^0.19.11",
    "typescript": "5.4.2"
  }
}
