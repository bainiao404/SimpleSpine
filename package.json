{
    "name": "simple-pixi-spine",
    "version": "0.1.6",
    "description": "Unified spine-pixi runtime with SimplePixiSpine wrapper built using Esbuild",
    "main": "./dist/simple-pixi-spine.js",
    "module": "./dist/simple-pixi-spine.mjs",
    "types": "./dist/types/src/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/types/src/index.d.ts",
            "node": {
                "import": "./dist/simple-pixi-spine-node.mjs"
            },
            "import": "./dist/simple-pixi-spine.mjs",
            "require": "./dist/simple-pixi-spine.js"
        }
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "node build.mjs && tsc"
    },
    "peerDependencies": {
        "@pixi/assets": "^7.0.0",
        "@pixi/core": "^7.0.0",
        "@pixi/display": "^7.0.0",
        "@pixi/graphics": "^7.0.0",
        "@pixi/mesh": "^7.0.0",
        "@pixi/mesh-extras": "^7.0.0",
        "@pixi/sprite": "^7.0.0"
    },
    "devDependencies": {
        "@esotericsoftware/spine-pixi-v7": "^4.2.83",
        "@pixi/assets": "^7.4.2",
        "@pixi/core": "^7.4.2",
        "@pixi/display": "^7.4.2",
        "@pixi/graphics": "^7.4.2",
        "@pixi/mesh": "^7.4.2",
        "@pixi/mesh-extras": "^7.4.2",
        "@pixi/sprite": "^7.4.2",
        "esbuild": "^0.19.11",
        "typescript": "5.4.2"
    },
    "keywords": [
        "spine",
        "pixi",
        "pixijs",
        "spine-pixi",
        "wrapper",
        "runtime",
        "web"
    ],
    "author": "bainiao404",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/bainiao404/simple-pixi-spine.git"
    },
    "bugs": {
        "url": "https://github.com/bainiao404/simple-pixi-spine/issues"
    },
    "homepage": "https://github.com/bainiao404/simple-pixi-spine#readme",
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@pixi/node": "^7.3.0"
    }
}
